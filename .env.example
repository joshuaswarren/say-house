# Copy to .env or .env.local. Never commit those files.
# Tokens, bridge keys, and model keys stay here, not in YAML.

# Which allowlist to load.
# Order when this is unset: config.local.yaml, then config.yaml, then config.example.yaml.
# SAYHOUSE_CONFIG=config.example.demo-home.yaml

# mock | homeassistant | hue
BACKEND=mock

# Home Assistant. Token may be HA_TOKEN or HASS_TOKEN.
# HA_URL is the origin only. Example over Tailscale:
# HA_URL=http://homeassistant.rhino-beaver.ts.net:8123
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HASS_TOKEN=

# Philips Hue bridge, local CLIP API v2. The app key is the username from the link-button pairing.
# HUE_BRIDGE_IP=
# HUE_APP_KEY=
# HUE_PORT=443

# OpenAI-compatible local model, via LiteLLM or any /v1 chat server.
# LAN (a cloud VM usually cannot reach this address — mock mode and npm run smoke still work):
# LLM_BASE_URL=http://192.168.10.150:4000/v1
# Tailscale:
# LLM_BASE_URL=http://100.72.149.4:4000/v1
# LLM_MODEL=qwen3.8-27b-64k-nothink
# If that alias is busy, LLM_MODEL=qwen3.8-27b-64k-fast
# Key: LLM_API_KEY, or LITELLM_API_KEY, or OPENAI_API_KEY. Never commit it.
# LLM_API_KEY=
# LLM_TIMEOUT_MS=25000
#
# Gemma is optional. Any open-weight model behind the same API works, for example Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=gemma4:e4b
# LLM_API_KEY=ollama

# Force every command to describe itself and send nothing.
# DRY_RUN=false
